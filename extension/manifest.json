{
  "manifest_version": 3,
  "name": "DriftAI Auto-Apply",
  "version": "0.2.0",
  "description": "Match jobs, auto-fill applications on Greenhouse/Lever/Ashby, and track status. Human submits — no CAPTCHA bypass, no bans.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://driftai.info/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DriftAI Auto-Apply"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
