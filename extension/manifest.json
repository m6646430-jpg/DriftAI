{
  "manifest_version": 3,
  "name": "DriftAI Auto-Apply",
  "version": "0.1.0",
  "description": "Auto-fill job applications on Greenhouse, Lever, and Ashby with your saved DriftAI profile. You review and submit.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DriftAI Auto-Apply"
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
